# Copy to .env and fill in. Never commit .env.

# Required for the pipeline and scrapers (the dashboard reads only static JSON)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/

# Pipeline enrichment / dashboard insights
DEEPSEEK_API_KEY=sk-...

# Scrapers
GITHUB_TOKEN=github_token
YOUTUBE_API_KEY=youtube_api_key
SERPER_API_KEY=                # optional, university-search fallback
CAPSOLVER_API_KEY=             # optional, browser search CAPTCHA solving
PROXY_URL=                     # optional, http://user:pass@host:port
UDEMY_COOKIE=                  # optional, MOOC scraper
